+export async function getPortfolioDashboard(
+  { recentDocumentLimit = 5, activityLimit = 20 } = {},
+) {
+  const { data } = await http.get('/api/portfolio/dashboard', {
+    params: {
+      recent_document_limit: recentDocumentLimit,
