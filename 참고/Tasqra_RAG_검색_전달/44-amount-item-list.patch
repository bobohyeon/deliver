+.amount-filter:hover:not(:disabled), .amount-filter:focus-visible:not(:disabled) { border-color: var(--c-accent); color: var(--c-text-strong); }
+.amount-filter.is-active { border-color: var(--c-text-strong); background: var(--c-text-strong); color: #fff; }
+/* 0 건인 조건은 누를 수 없게 두되 **숨기지 않는다** — 없어진 것과 0 건인 것은 다르다. */
+.amount-filter:disabled { background: var(--c-bg-hover); color: var(--c-text-muted); cursor: not-allowed; }
+
+/* 표가 좁은 화면에서 잘리지 않게 가로 스크롤을 준다. 칸을 줄이면 금액이 줄바꿈된다. */
+.amount-table-scroll { overflow-x: auto; }
+.amount-items-table { width: 100%; min-width: 760px; border-collapse: collapse; }
+.amount-items-table th, .amount-items-table td { padding: 10px 12px; border-bottom: 1px solid var(--c-border); text-align: left; vertical-align: top; }
+.amount-items-table thead th { color: var(--c-text-muted); font-size: 12px; font-weight: 700; white-space: nowrap; }
+.amount-items-table tbody th { font-weight: 700; }
+.amount-items-table tbody th > strong { display: block; color: var(--c-text-strong); font-size: 14px; }
+/* 어긋난 줄. 색을 쓰지 않고 왼쪽 굵은 선으로만 표시한다 — 산출물 화면의
+   '갱신 필요' 와 같은 방식이라 두 화면이 같은 규칙으로 읽힌다. */
+.amount-items-table tbody tr.is-mismatch th { box-shadow: inset 3px 0 0 var(--c-text-strong); }
+
+/* 문서 파일명. 항목 아래에 작게 둔다. 길면 줄이고 마우스를 올리면 전체가 보인다. */
+.amount-item-source { display: block; max-width: 220px; margin-top: 4px; overflow: hidden; color: var(--c-text-muted); font-size: 11px; font-weight: 400; text-overflow: ellipsis; white-space: nowrap; }
+
+.amount-verify { font-size: 12px; font-weight: 700; white-space: nowrap; }
+.amount-verify.is-ok { color: var(--c-text-muted); }
+/* 어긋난 것만 진하게. 맞은 줄까지 강조하면 어느 것이 문제인지 안 보인다. */
+.amount-verify.is-bad { color: var(--c-text-strong); }
+.amount-verify.is-muted { color: var(--c-text-muted); font-weight: 400; }
+
+/* 원문 근거. 한 줄로 줄이고 title 로 전체를 보여준다(마우스 올리면 뜬다).
+   cursor: help 로 "올리면 뭔가 나온다" 를 미리 알린다 — 안 그러면 아무도 안 올린다. */
+.amount-quote { max-width: 260px; overflow: hidden; color: var(--c-text-muted); font-size: 12px; text-overflow: ellipsis; white-space: nowrap; cursor: help; }
