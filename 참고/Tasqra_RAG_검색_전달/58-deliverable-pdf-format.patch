+#   PDF 는 render_html 을 감싸 WeasyPrint 로 굽는다(deliverable_pdf.py).
 RENDERERS = {
     "MD": render_markdown,
     "HTML": render_html,
     "XLSX": render_xlsx,
+    "PDF": render_pdf,
 }
 
 logger = logging.getLogger(__name__)
