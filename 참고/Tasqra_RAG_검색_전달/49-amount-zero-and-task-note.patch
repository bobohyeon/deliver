+// =============================================================================
+// 이 파일의 책임: 태스크 설명 끝에 붙는 **자동 기록 블록**을 사람이 쓴 부분과
+//   분리한다. 보드 카드가 그 블록만 다른 색으로 그릴 수 있게 하는 것이 목적이다.
+// 다른 파일과의 관계: features/board/BoardView.jsx 가 카드를 그릴 때 쓴다.
+//   블록을 만드는 쪽은 백엔드 services/task_service.py 의 AUTO_NOTE_MARKER 다.
+// Spring 비교: 표시용 문자열 파싱이라 대응물이 없다. 굳이 대면 뷰에서 쓰는
+//   유틸 클래스(JSP 의 커스텀 태그 함수) 자리다.
+//
+// ⚠ 표시 문자열이 백엔드와 **글자까지 같아야 한다**
+//   backend/app/services/task_service.py 의 AUTO_NOTE_MARKER 와 한 글자라도
+//   다르면 블록을 못 찾아서 색이 안 입고 그냥 본문에 섞여 나온다. 에러가 나지
+//   않으므로 알아채기 어렵다. 한쪽을 고치면 **반드시 다른 쪽도** 고친다.
+//
+//   상수를 한 곳에 두지 못하는 이유: 백엔드는 파이썬이고 화면은 자바스크립트라
+//   같은 파일을 공유할 수 없다. 서버가 응답에 구분자를 실어 보내는 방법도 있지만,
+//   설명은 그냥 텍스트 컬럼이라 그러려면 태스크 응답 모양을 바꿔야 한다.
+// =============================================================================
+
+export const AUTO_NOTE_MARKER = '── 자동 기록 ──'
+
+/** 설명을 [사람이 쓴 부분, 자동 기록] 으로 나눈다.
+ *
+ *  자동 기록이 없으면 두 번째가 빈 문자열이다. 구분자가 여러 번 있으면
+ *  **처음 것**에서 나눈다 — 서버가 늘 마지막 블록만 남기므로 정상적으로는 하나뿐이고,
+ *  사람이 실수로 같은 글자를 적었더라도 사람이 쓴 것을 먼저 보여주는 쪽이 안전하다.
+ */
+export function splitAutoNote(text) {
+  if (!text) return ['', '']
+  const at = text.indexOf(AUTO_NOTE_MARKER)
+  if (at === -1) return [text, '']
+  return [
+    text.slice(0, at).trimEnd(),
+    text.slice(at + AUTO_NOTE_MARKER.length).trim(),
+  ]
+}
