+def test_keeps_search_order():
+    """관련도 순을 문서·조각 번호로 다시 정렬하지 않는다."""
+    chunks = [
+        chunk(30, "가장 관련 높은 근거다.", seq=29, document_id=9, filename="나중문서.pdf"),
+        chunk(1, "그다음 근거다.", seq=0, document_id=1, filename="첫문서.pdf"),
+    ]
