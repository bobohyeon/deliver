diff --git a/frontend/src/styles/workspace.css b/frontend/src/styles/workspace.css
index 8526e27..074da2f 100644
--- a/frontend/src/styles/workspace.css
+++ b/frontend/src/styles/workspace.css
@@ -109,3 +109,62 @@
   .dashboard-notice { align-items: flex-start; flex-direction: column; }
   .dashboard-notice button { width: 100%; }
 }
+
+
+/* ═══ 사이드바 고정 ═══════════════════════════════════════════════════════
+   문제 — 페이지가 길어지면 사이드바가 끊겨 보인다. 대시보드에 카드와 패널이
+   늘어난 뒤 눈에 띄었다.
+
+   전에는 sticky + 고정 높이였다.
+     .workspace-shell  display:grid · grid-template-columns:280px minmax(0,1fr) · align-items:start
+     .project-sidebar  position:sticky · top:84px · height:calc(100vh - 84px)
+
+   sticky 는 조상 중 하나에 overflow 가 걸리거나 그리드 배치가 조금 달라지면
+   조용히 무력해진다. 그때 사이드바는 자기 높이(한 화면)만큼만 흰색이고 그 아래
+   280px 열이 비어 회색 배경이 드러난다. 즉 "끊긴 것처럼" 보인다.
+
+   position:fixed 로 바꾼다. 항상 화면 전체 높이(헤더 아래 ~ 화면 끝)를 차지하므로
+   **그 종류의 빈틈이 구조적으로 생기지 않는다.** 프로젝트가 많아 목록이 길어지면
+   .project-sidebar__list 안에서만 스크롤한다(그 규칙은 이미 있다).
+
+   fixed 는 그리드 흐름에서 빠지므로 두 가지를 함께 고쳐야 한다.
+     1. .workspace-shell 을 block 으로 — grid 로 두면 .workspace-content 가
+        첫 열(280px)에 들어가 본문이 찌그러진다
+     2. .workspace-content 에 margin-left:280px — 본문이 사이드바 아래로
+        깔리지 않게
+
+   브레이크포인트는 위쪽 @media(max-width:900px) 블록의 **정확한 여집합**으로 잡았다.
+   그 블록이 좁은 화면에서 사이드바를 가로 스크롤 형태로 바꾸므로 거기서는 이
+   규칙이 적용되지 않아야 한다.
+
+   min-width:901px 이 아니라 not all and (max-width:900px) 를 쓴 이유
+     min-width:901px 로 하면 900px 과 901px 사이에 틈이 생긴다. 브라우저 확대나
+     배율이 있는 화면에서는 뷰포트 폭이 900.5px 처럼 소수가 될 수 있고, 그 폭에서는
+     max-width:900px 도 min-width:901px 도 적용되지 않아 사이드바가 옛 배치로
+     돌아간다(= 끊김이 다시 보일 수 있다). not all and (...) 는 여집합이라 틈이 없다.
+     이 규칙이 무조건 적용되게 두면 안 된다 — 위 max-width:900px 블록보다 뒤에
+     있으므로 좁은 화면에서 그 블록을 덮어써 모바일 배치가 깨진다.
+
+   z-index 25 — 헤더(30)보다 아래, 탭(20)보다 위. 가로로 겹치지는 않지만 헤더가
+   항상 위에 있어야 한다.
+
+   값을 그대로 적은 것은 이 파일이 이미 280px·84px 를 그렇게 쓰고 있어서다.
+   변수로 뽑는 것은 tokens.css 정리(UI 시안 확정 후)에서 함께 한다.
+
+   알려진 별개 문제 — 헤더는 responsive.css 에서 800px 이하일 때 72px 이 되는데
+   이 파일의 사이드바 블록은 900px 기준으로 72px 을 가정한다. 801~900px 구간에서
+   12px 이 어긋난다. 이번 변경과 무관한 기존 문제이므로 손대지 않았다.
+   ═════════════════════════════════════════════════════════════════════════ */
+@media not all and (max-width: 900px) {
+  .workspace-shell { display: block; }
+  .project-sidebar {
+    position: fixed;
+    top: 84px;
+    bottom: 0;
+    left: 0;
+    width: 280px;
+    height: auto;
+    z-index: 25;
+  }
+  .workspace-content { margin-left: 280px; }
+}
