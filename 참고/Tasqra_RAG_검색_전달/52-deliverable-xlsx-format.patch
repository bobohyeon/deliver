new file mode 100644
index 0000000..57bc43f
--- /dev/null
+++ b/backend/app/services/deliverable_xlsx.py
@@ -0,0 +1,124 @@
+# =============================================================================
+# 이 파일의 책임: 산출물 문서 구조(DeliverableDocument)를 XLSX 바이트로 바꾼다.
+#   절을 고르는 규칙은 여기 없다 — deliverable_markdown.build_document 가 정한다.
+#   MD·HTML 과 달리 이 파일은 **파일 객체가 아니라 bytes 를 돌려준다** — XLSX 는
+#   zip 컨테이너라 텍스트로 다룰 수 없다(deliverable_service._write_file 참고).
+#
+# 다른 파일과의 관계
+#   services/deliverable_markdown.py  문서 구조(DeliverableDocument)와 그 빌더
+#   services/deliverable_service.py   RENDERERS["XLSX"] 로 이 함수를 부른다
+#   schemas/deliverable.py            FORMAT_FILE_TYPES["XLSX"] 의 확장자·MIME
+#
+# Spring 비교: 같은 모델을 뷰로 그리는 것은 HTML 과 같다. 다만 Apache POI 의
+#   Workbook 처럼 openpyxl 의 Workbook 이 파일 전체를 메모리에 들고 있다가
+#   save() 에서 한 번에 바이트로 굳는다 — ByteArrayOutputStream 에 쓰는 것과 같다.
+#
+# ⚠ 값을 escape 하지 않는다 — XLSX 에는 그 문제가 없다
+#   Markdown 은 `|` 가 표를 깨고 HTML 은 `<` 가 태그가 된다. XLSX 는 셀 값이
+#   문자열로 그대로 들어가고 브라우저에서 실행되지 않으므로 이 형식만의 escape
+#   규칙이 없다. 그래도 `openpyxl` 이 문자열이 아닌 값(`Decimal` 등)을 거부할 수
+#   있어 `deliverable_markdown.clean()` 이 만든 문자열을 그대로 쓴다 — 세 형식이
+#   같은 문자열을 보게 하는 것이 목적이다(머리말 "한쪽에만 절을 더하는 실수"와
+#   같은 이유).
+#
+# ⚠ 색을 쓰지 않는다 — deliverable_html.py 와 같은 판단
+#   강조는 헤더 행 배경(회색)과 굵은 글씨 하나로만 한다.
+# =============================================================================
+
+from __future__ import annotations
+
+from io import BytesIO
+from typing import Any
+
+from openpyxl import Workbook
+from openpyxl.styles import Alignment, Font, PatternFill
+from openpyxl.utils import get_column_letter
+from openpyxl.worksheet.worksheet import Worksheet
+
+from app.services.deliverable_markdown import DeliverableDocument, build_document
+
+__all__ = ["render_xlsx", "to_xlsx"]
+
+# 시트 이름에 못 쓰는 문자(엑셀 규칙: \ / ? * [ ] :)와 31자 길이 제한이 있다.
+_SHEET_NAME_LIMIT = 31
+_INVALID_SHEET_CHARS = str.maketrans({c: " " for c in "\\/?*[]:"})
+
+_HEADER_FILL = PatternFill(fill_type="solid", start_color="F2F2F2", end_color="F2F2F2")
+_HEADER_FONT = Font(bold=True)
+_WRAP = Alignment(wrap_text=True, vertical="top")
+
+
+def render_xlsx(**kwargs: Any) -> bytes:
+    """산출물 본문을 XLSX 바이트로. 인자는 build_document 와 같다."""
+    return to_xlsx(build_document(**kwargs))
+
+
+def to_xlsx(document: DeliverableDocument) -> bytes:
+    """문서 구조를 워크북으로 바꾸고 바이트로 굳힌다.
+
+    표가 있는 절은 시트 하나, 표가 없는 절(개요 등)은 "안내" 시트에 문단으로
+    모은다. 절마다 시트를 만들지 않는 이유는 표 없는 절이 늘어날 때 빈 시트가
+    쌓이는 것을 막기 위해서다 — 지금은 개요 하나뿐이라 차이가 작지만, 규칙은
+    "표가 있어야 시트가 된다" 로 단순하게 둔다.
+    """
+    workbook = Workbook()
+    # 기본으로 생성되는 빈 시트("Sheet")를 먼저 요약 시트로 바꿔 쓴다.
+    summary = workbook.active
+    summary.title = "요약"
+    _write_summary(summary, document)
+
+    notes: list[str] = []
+    for section in document.sections:
+        if section.header and section.rows:
+            sheet = workbook.create_sheet(_sheet_name(section.title, workbook))
+            _write_table(sheet, section.header, section.rows)
+        elif section.note:
+            notes.append(f"[{section.title}] {section.note}")
+
+    if notes:
+        note_sheet = workbook.create_sheet("안내")
+        for row_index, text in enumerate(notes, start=1):
+            note_sheet.cell(row=row_index, column=1, value=text)
+        note_sheet.column_dimensions["A"].width = 80
+
+    buffer = BytesIO()
+    workbook.save(buffer)
+    return buffer.getvalue()
+
+
+def _write_summary(sheet: Worksheet, document: DeliverableDocument) -> None:
+    sheet.cell(row=1, column=1, value=document.title).font = Font(bold=True, size=14)
+    for offset, line in enumerate(document.meta, start=2):
+        sheet.cell(row=offset, column=1, value=line)
+    sheet.column_dimensions["A"].width = 60
+
+
+def _write_table(sheet: Worksheet, header: list[str], rows: list[list[str]]) -> None:
+    for col_index, name in enumerate(header, start=1):
+        cell = sheet.cell(row=1, column=col_index, value=name)
+        cell.font = _HEADER_FONT
+        cell.fill = _HEADER_FILL
+    for row_index, row in enumerate(rows, start=2):
+        for col_index, value in enumerate(row, start=1):
+            cell = sheet.cell(row=row_index, column=col_index, value=value)
+            cell.alignment = _WRAP
+    for col_index in range(1, len(header) + 1):
+        sheet.column_dimensions[get_column_letter(col_index)].width = 22
+
+
+def _sheet_name(title: str, workbook: Workbook) -> str:
+    """시트 이름을 엑셀 규칙에 맞춘다.
+
+    31자를 넘거나 같은 이름이 이미 있으면 잘라내고 번호를 붙인다. 지금 절 이름
+    (문서·완료한 태스크·결정사항·일정·기한·금액)은 다 짧고 서로 달라 번호가
+    붙을 일은 없지만, 규칙은 지켜 둔다.
+    """
+    cleaned = title.translate(_INVALID_SHEET_CHARS).strip() or "절"
+    name = cleaned[:_SHEET_NAME_LIMIT]
+    if name not in workbook.sheetnames:
+        return name
+    for suffix in range(2, 100):
+        candidate = f"{cleaned[: _SHEET_NAME_LIMIT - 3]}_{suffix}"
+        if candidate not in workbook.sheetnames:
+            return candidate
+    return cleaned[:_SHEET_NAME_LIMIT]
