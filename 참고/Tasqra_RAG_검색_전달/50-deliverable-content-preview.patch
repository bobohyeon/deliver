+function ContentPreview({ projectId, kind, periodFrom, periodTo }) {
+  const contentQuery = useQuery({
+    queryKey: ['projects', projectId, 'deliverable-content', kind, periodFrom, periodTo],
+    queryFn: () => getDeliverableContent(projectId, { kind, periodFrom, periodTo }),
+    enabled: Boolean(periodFrom && periodTo),
+    retry: false,
+  })
+
+  return <section className='panel deliverable-content' aria-label='산출물 미리보기'>
+    <div className='deliverable-content-heading'>
+      <h2>{contentQuery.data?.title ?? '미리보기'}</h2>
+      <span>아직 만들지 않았습니다. 이력에도 남지 않습니다.</span>
+    </div>
+
+    {contentQuery.isPending
+      ? <p className='deliverable-content-empty'>본문을 만드는 중입니다.</p>
+      : contentQuery.isError
+        ? <p className='deliverable-content-empty'>미리보기를 만들지 못했습니다. {contentQuery.error?.message}</p>
+        : <>
+          <pre className='deliverable-content-body'>{contentQuery.data.body}</pre>
+          <p className='deliverable-content-note'>
+            형식(<strong>MD</strong>·<strong>HTML</strong>)에 따라 모양은 달라지지만
+            <strong> 담길 내용은 같습니다</strong> — 절을 고르는 규칙이 하나입니다.
+          </p>
+        </>}
   </section>
