+    # pytest 가 없을 수 있어서다. pytest 로 돌리면 아래 블록은 실행되지 않고
+    # 각 test_* 함수가 개별 테스트로 수집된다.
+    tests = [
+        test_plain_text,
+        test_drop_header_footer,
+        test_table,
+        test_two_tables_separate,
+        test_long_line,
+        test_no_space_long_line,
