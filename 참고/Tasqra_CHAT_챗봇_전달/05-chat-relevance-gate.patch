+    def _search_is_relevant(
+        self,
+        results: Sequence[SearchResultItem],
+    ) -> tuple[bool, float | None]:
+        """정확 키워드 일치 또는 충분한 vector cosine이 있는지 판정한다.
+
+        하이브리드 첫 결과는 RRF·리랭커 순서라 최고 cosine이라는 보장이 없다.
+        keyword-only의 similarity는 cosine이 아니므로 vector 최댓값에서 제외한다.
+        """
+        has_exact_keyword_match = any(
+            item.match_kind in {"keyword", "both"}
+            and (item.match_count or 0) > 0
+            for item in results
+        )
+        vector_similarities = [
+            item.similarity
+            for item in results
+            if item.match_kind in {None, "vector", "both"}
+        ]
+        best_vector_similarity = (
+            max(vector_similarities) if vector_similarities else None
+        )
+        relevant = has_exact_keyword_match or (
+            best_vector_similarity is not None
+            and best_vector_similarity >= self._settings.CHAT_MIN_VECTOR_SIMILARITY
+        )
+        return relevant, best_vector_similarity
+
