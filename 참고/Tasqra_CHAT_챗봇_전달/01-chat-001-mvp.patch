@@ -0,0 +1,27 @@
+/* =============================================================================
+   이 파일의 책임: 문서 챗봇(CHAT-001) 질문 폼·답변·원문 근거 목록을 배치한다.
+   다른 파일과의 관계: ChatView.jsx가 사용하며 panel·primary 등 공통 스타일은
+   기존 전역 스타일을 재사용한다.
+   Spring 비교: 서버 템플릿의 feature 전용 stylesheet와 같은 역할이다.
+   ============================================================================= */
+
+.chat-panel { display: flex; flex-direction: column; gap: 14px; }
+.chat-form label { display: block; margin-bottom: 9px; color: var(--c-text-strong); font-weight: 800; }
+.chat-form-row { display: flex; align-items: flex-end; gap: 10px; }
+.chat-form textarea { flex: 1; min-width: 0; resize: vertical; padding: 12px 14px; border: 1px solid var(--c-border); border-radius: 10px; background: var(--c-bg); color: var(--c-text-strong); line-height: 1.6; }
+.chat-form textarea:focus { border-color: var(--c-accent); outline: 3px solid var(--c-accent-bg); }
+.chat-form p, .chat-answer .panel-head p { margin: 9px 0 0; color: var(--c-text-muted); font-size: 12px; line-height: 1.6; }
+.chat-error, .chat-answer { margin-top: 20px; }
+.chat-error { border-left: 4px solid var(--c-text-strong); }
+.chat-error p { margin: 8px 0; }
+.chat-answer .panel-head p { color: var(--c-text); font-size: 15px; white-space: pre-wrap; }
+.chat-answer h3 { margin: 22px 0 10px; font-size: 14px; }
+.chat-evidence-list { display: flex; flex-direction: column; gap: 10px; margin: 0; padding-left: 22px; }
+.chat-evidence-list button { width: 100%; padding: 14px 16px; border: 1px solid var(--c-border); border-radius: 12px; background: var(--c-bg); color: var(--c-text); text-align: left; cursor: pointer; }
+.chat-evidence-list button:hover { border-color: var(--c-border-strong); background: var(--c-bg-hover); }
+.chat-evidence-list strong, .chat-evidence-list span { display: block; }
+.chat-evidence-list span { margin-top: 4px; color: var(--c-text-muted); font-size: 12px; }
+.chat-evidence-list blockquote { margin: 12px 0 0; padding-left: 12px; border-left: 3px solid var(--c-text-strong); color: var(--c-text); line-height: 1.7; white-space: pre-wrap; }
+.chat-no-evidence, .chat-budget { color: var(--c-text-muted); font-size: 12px; }
+.chat-budget { margin: 16px 0 0; }
+@media (max-width: 640px) { .chat-form-row { align-items: stretch; flex-direction: column; } }
diff --git a/frontend/src/features/chat/ChatView.jsx b/frontend/src/features/chat/ChatView.jsx
new file mode 100644
index 0000000..17d3b5d
--- /dev/null
+++ b/frontend/src/features/chat/ChatView.jsx
@@ -0,0 +1,90 @@
+// =============================================================================
+// 이 파일의 책임: 현재 프로젝트 문서에 질문 한 건을 보내고 답변과 서버가 검증한
+//   원문 근거를 함께 표시한다(CHAT-001 MVP).
+// 다른 파일과의 관계: WorkspacePage의 chat 탭에서 렌더링되고 api/chat.js만
+//   호출한다. 근거를 누르면 기존 문서 원문 화면의 해당 청크 구간으로 이동한다.
+// Spring 비교: 단건 Command form과 응답 View를 한 React 컴포넌트로 묶은 형태다.
+// =============================================================================
+
+import { useState } from 'react'
+import { useMutation } from '@tanstack/react-query'
+import { useNavigate } from 'react-router-dom'
+import PageHeading from '../../components/common/PageHeading'
+import { askProjectDocuments } from '../../api/chat'
+import './ChatView.css'
+
+export default function ChatView({ projectId }) {
+  const [question, setQuestion] = useState('')
+  const navigate = useNavigate()
+  const chat = useMutation({ mutationFn: value => askProjectDocuments(projectId, value) })
+
+  function submit(event) {
+    event.preventDefault()
+    const trimmed = question.trim()
+    if (!trimmed || chat.isPending) return
+    chat.mutate(trimmed)
+  }
+
+  function openEvidence(item) {
+    const target = `/projects/${item.project_id}/documents/${item.document_id}`
+    if (item.content_start === null || item.content_end === null) {
+      navigate(target)
+      return
+    }
+    const params = new URLSearchParams({
+      tab: 'content',
+      from: String(item.content_start),
+      to: String(item.content_end),
+    })
+    navigate(`${target}?${params.toString()}`)
+  }
+
+  return <>
+    <PageHeading
+      eyebrow='DOCUMENT Q&A'
+      title='문서 챗봇'
+      description='현재 프로젝트에서 접근 가능한 문서를 찾아 답하고, 사용한 원문 근거를 함께 보여줍니다.'/>
+
+    <section className='panel chat-panel'>
+      <form className='chat-form' onSubmit={submit}>
+        <label htmlFor='chat-question'>프로젝트 문서에 질문하기</label>
+        <div className='chat-form-row'>
+          <textarea id='chat-question' value={question} maxLength={1000} rows={3}
+            onChange={event => setQuestion(event.target.value)}
+            placeholder='예: 대금 지급 조건과 기한을 근거와 함께 알려주세요.'/>
+          <button className='primary' type='submit' disabled={!question.trim() || chat.isPending}>
+            {chat.isPending ? '답변 생성 중...' : '질문하기'}
+          </button>
+        </div>
+        <p>질문마다 독립적으로 답합니다. 대화 이력은 저장하거나 다음 질문에 전달하지 않습니다.</p>
+      </form>
+    </section>
+
+    {chat.isError && <section className='panel chat-error'>
+      <strong>답변을 만들지 못했습니다.</strong>
+      <p>{chat.error?.message}</p>
+      {chat.error?.code && <small>코드 {chat.error.code}</small>}
+    </section>}
+
+    {chat.data && <ChatAnswer response={chat.data} onOpen={openEvidence}/>}
+  </>
+}
+
+function ChatAnswer({ response, onOpen }) {
+  return <section className='panel chat-answer' aria-live='polite'>
+    <div className='panel-head'><div><h2>답변</h2><p>{response.answer}</p></div></div>
+    {response.evidence.length > 0 ? <>
+      <h3>근거 문서와 원문 인용</h3>
+      <ol className='chat-evidence-list'>
+        {response.evidence.map(item => <li key={item.evidence_id}>
+          <button type='button' onClick={() => onOpen(item)}>
+            <strong>[근거 {item.evidence_id}] {item.document_filename}</strong>
+            <span>{item.page_number ? `${item.page_number}쪽 · ` : ''}조각 {item.seq + 1}번</span>
+            <blockquote>{item.quote}</blockquote>
+          </button>
+        </li>)}
+      </ol>
+    </> : <p className='chat-no-evidence'>답변에 사용된 문서 근거가 없습니다.</p>}
+    <p className='chat-budget'>근거 예산 {response.evidence_used_tokens}/{response.evidence_budget_tokens} · {response.token_counter}{response.token_count_is_exact ? '' : ' (보수적 근사)'}</p>
+  </section>
+}
