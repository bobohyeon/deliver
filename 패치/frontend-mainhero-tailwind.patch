+            <a key={item} href="#" className="transition-colors hover:text-slate-900">
+              {item}
+            </a>
+          ))}
+        </nav>
+
+        <div className="flex items-center gap-2 md:gap-3">
+          <a
+            href="#"
+            className="hidden rounded-full border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50 sm:inline-block"
+          >
+            로그인
+          </a>
+          <a
+            href="#"
+            className="rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-slate-800"
+          >
+            무료로 시작하기
+          </a>
+        </div>
+      </div>
+    </header>
+  )
+}
+
+function StatItem({ icon: Icon, label, value }) {
+  return (
+    <div className="flex items-center gap-2.5">
+      <span className="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-blue-50 text-blue-600">
+        <Icon className="h-4 w-4" />
+      </span>
+      <div className="leading-tight">
+        <dt className="text-[13px] text-slate-500">{label}</dt>
+        <dd className="text-base font-bold text-slate-900">{value}</dd>
+      </div>
+    </div>
+  )
+}
+
+function FlowCard({ icon: Icon, tone, title, desc }) {
+  return (
+    <div className="rounded-2xl border border-slate-200 bg-white p-3 shadow-sm md:p-4">
+      <div className={`flex h-8 w-8 items-center justify-center rounded-lg ${tone}`}>
+        <Icon className="h-4 w-4" />
+      </div>
+      <p className="mt-2 text-[13px] font-bold text-slate-800">{title}</p>
+      <p className="mt-1 text-[11px] leading-snug text-slate-400">{desc}</p>
+    </div>
+  )
+}
+
+// 임시 배경 이미지(요구사항 4). 시안 자체는 사진 없는 화이트 배경이라 전면에 깔면
+// 원본과 달라지므로, 우측 일러스트 패널 뒤에 아주 낮은 불투명도로만 얹어 톤을 보강했다.
+// 출처: Alexandre Debiève, Unsplash (unsplash.com/photos/FO7JIlwjOtU) — 실제 배포 전 교체 권장.
+const HERO_BG_IMAGE =
+  'https://images.unsplash.com/photo-1518770660439-4636190af475?q=80&w=1600&auto=format&fit=crop'
+
+function FlowIllustration() {
+  return (
+    <div
+      className="relative mx-auto aspect-[4/3] w-full max-w-md overflow-hidden rounded-3xl bg-gradient-to-br from-slate-50 to-blue-50/60 p-4 md:max-w-lg md:p-8"
+      style={{
+        backgroundImage: `linear-gradient(to bottom right, rgba(248,250,252,0.94), rgba(239,246,255,0.9)), url(${HERO_BG_IMAGE})`,
+        backgroundSize: 'cover',
+        backgroundPosition: 'center',
+      }}
+    >
+      {/* 업로드 카드 */}
+      <div className="absolute left-2 top-2 w-36 rounded-2xl border border-slate-200 bg-white p-3 shadow-sm md:left-4 md:top-4 md:w-44">
+        <div className="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
+          <FileText className="h-5 w-5" />
+        </div>
+        <p className="mt-2 text-xs font-bold text-slate-800">문서 드래그 &amp; 업로드</p>
+        <p className="mt-1 text-[11px] leading-snug text-slate-400">PDF, DOCX, HWP, XLS, PPT 등</p>
+        <ArrowDown className="mt-2 h-4 w-4 text-slate-300" />
+      </div>
+
+      {/* 연결선 */}
+      <svg className="absolute inset-0 h-full w-full" viewBox="0 0 400 300" fill="none" aria-hidden="true">
+        <path d="M195 165 L300 90" stroke="#c7d2fe" strokeWidth="1.5" />
+        <path d="M195 165 L300 165" stroke="#c7d2fe" strokeWidth="1.5" />
+        <path d="M195 165 L300 240" stroke="#c7d2fe" strokeWidth="1.5" />
+      </svg>
+
+      {/* 중앙 허브(T 로고) */}
+      <div className="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
+        <div className="relative flex h-20 w-20 items-center justify-center rounded-full bg-gradient-to-br from-blue-400 to-indigo-600 shadow-xl shadow-blue-500/30 md:h-24 md:w-24">
+          <span className="text-2xl font-bold text-white md:text-3xl">T</span>
+          <span className="absolute -inset-3 rounded-full border border-blue-200/70" />
+        </div>
+      </div>
+
+      {/* 우측 결과 카드 3개 */}
+      <div className="absolute right-1 top-1 flex w-36 flex-col gap-2.5 md:right-2 md:top-2 md:w-52 md:gap-4">
+        {FLOW_CARDS.map(card => <FlowCard key={card.title} {...card} />)}
+      </div>
+    </div>
+  )
+}
+
+export default function MainHero() {
+  return (
+    <div className="bg-white">
+      <SiteHeader />
+
+      <section className="relative overflow-hidden">
+        <div className="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_80%_20%,rgba(59,130,246,0.08),transparent_45%)]" />
+
+        <div className="relative mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 px-4 py-12 md:grid-cols-2 md:gap-8 md:px-8 md:py-20">
+          <div>
+            <h1 className="text-4xl font-extrabold leading-[1.15] tracking-tight text-slate-900 md:text-5xl lg:text-[56px]">
+              복잡한 문서를
+              <br />
+              명확한 실행으로
+            </h1>
+
+            <p className="mt-5 max-w-md text-base leading-relaxed text-slate-500 md:text-lg">
+              AI가 문서의 핵심을 분석하고,
+              <br className="hidden md:block" />
+              프로젝트와 태스크로 전환해 실행을 지원합니다.
+            </p>
+
+            <div className="mt-8 flex flex-wrap items-center gap-3">
+              <a
+                href="#"
+                className="inline-flex items-center gap-2 rounded-full bg-slate-900 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-slate-900/20 transition-colors hover:bg-slate-800 md:text-base"
+              >
+                무료로 시작하기
+                <ArrowRight className="h-4 w-4" />
+              </a>
+              <a
+                href="#features"
+                className="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-6 py-3.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50 md:text-base"
+              >
+                기능 살펴보기
+              </a>
+            </div>
+
+            <dl className="mt-12 grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-4">
+              {STATS.map(stat => <StatItem key={stat.label} {...stat} />)}
+            </dl>
+          </div>
+
+          <FlowIllustration />
+        </div>
+      </section>
+    </div>
+  )
+}
