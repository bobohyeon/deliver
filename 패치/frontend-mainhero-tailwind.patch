+// 시안(첨부 이미지) 1:1 카피용 메인 히어로 컴포넌트.
+// 헤더 + 히어로(좌: 텍스트/CTA/통계, 우: 문서→AI→결과 플로우 일러스트)를 한 파일에 담았다.
+// LandingPage.jsx 상단에서 <MainHero/> 로 불러와 쓴다.
+//
+// 아이콘은 lucide-react 대신 인라인 SVG로 자체 구현했다. 이 샌드박스의 네트워크가
+// npm 레지스트리 접근을 막아 lucide-react 설치가 불가능했기 때문(설치 시도 시 403).
+// 실제 개발 환경에서는 `npm install lucide-react` 로 설치한 뒤 아래 Icons 객체를
+// `import { ArrowDown, ArrowRight, ... } from 'lucide-react'` 로 교체해도 무방하다 —
+// props(className 등) 시그니처를 동일하게 맞춰두었다.
+import Icons from './heroIcons'
+
+const {
+  ArrowDown,
+  ArrowRight,
+  CheckCircle2,
+  Clock3,
+  FileText,
+  LayoutGrid,
+  ListChecks,
+  ShieldCheck,
+  Sparkles,
+  TrendingUp,
+} = Icons
+
+const NAV_ITEMS = ['제품소개', '기능', '요금제', '고객사']
+
+const STATS = [
+  { icon: CheckCircle2, label: '문서 분석 정확도', value: '98%' },
+  { icon: Clock3, label: '검토 시간 단축', value: '70%' },
+  { icon: TrendingUp, label: '누적 프로젝트', value: '10,000+' },
+  { icon: ShieldCheck, label: '보안 인증', value: 'ISO/ISMS-P' },
+]
+
+const FLOW_CARDS = [
+  {
+    icon: LayoutGrid,
+    tone: 'bg-violet-50 text-violet-600',
+    title: '프로젝트 생성',
+    desc: '요구사항 분석, 설계, 개발, 테스트, 배포까지 지원 구성',
+  },
+  {
+    icon: ListChecks,
+    tone: 'bg-blue-50 text-blue-600',
+    title: '태스크 및 일정 생성',
+    desc: 'WBS 기반 태스크와 일정을 자동으로 생성',
+  },
+  {
+    icon: Sparkles,
+    tone: 'bg-emerald-50 text-emerald-600',
+    title: '핵심 요약 제공',
+    desc: '핵심 키워드와 요약으로 문서 내용 파악',
+  },
+]
+
+function LogoMark({ className = 'h-8 w-8' }) {
+  return (
+    <svg viewBox="0 0 32 32" className={className} aria-hidden="true">
+      <defs>
+        <linearGradient id="hero-logo" x1="0" y1="0" x2="1" y2="1">
+          <stop offset="0" stopColor="#7fb3ff" />
+          <stop offset="1" stopColor="#3f5bd9" />
+        </linearGradient>
+      </defs>
+      <circle cx="16" cy="15" r="9.5" fill="url(#hero-logo)" />
+      <ellipse cx="16" cy="16" rx="14.5" ry="5.6" fill="none" stroke="#7ca6eb" strokeWidth="1.5" opacity=".9" transform="rotate(-22 16 16)" />
+      <path d="M11.4 11.2h9.2M16 11.2v9.6" stroke="#fff" strokeWidth="2.4" strokeLinecap="round" />
+      <circle cx="26" cy="7" r="1.1" fill="#7ca6eb" />
+      <circle cx="6" cy="24" r=".8" fill="#7ca6eb" />
+    </svg>
+  )
+}
+
+function SiteHeader() {
+  return (
+    <header className="sticky top-0 z-30 border-b border-slate-200 bg-white/90 backdrop-blur">
+      <div className="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 md:h-20 md:px-8">
+        <div className="flex items-center gap-2">
+          <LogoMark />
+          <span className="text-lg font-bold text-slate-900 md:text-xl">Tasqra</span>
+        </div>
