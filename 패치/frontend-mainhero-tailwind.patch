+// MainHero.jsx 전용 아이콘 세트.
+// lucide-react 패키지 없이도 프리뷰가 즉시 뜨도록 동일한 선 굵기(stroke=2)로
+// 인라인 SVG 아이콘을 직접 그렸다. Spring 비유: 외부 스타터(lucide-react)를
+// 못 받아오는 상황에서 같은 인터페이스(props: className)를 갖는 로컬 구현체를
+// 대신 주입한 것과 같다 — 나중에 패키지가 설치되면 이 파일만 지우고
+// import 문을 lucide-react로 바꾸면 된다.
+function Icon({ children, className = 'h-4 w-4' }) {
+  return (
+    <svg
+      viewBox="0 0 24 24"
+      fill="none"
+      stroke="currentColor"
+      strokeWidth="2"
+      strokeLinecap="round"
+      strokeLinejoin="round"
+      className={className}
+      aria-hidden="true"
+    >
+      {children}
+    </svg>
+  )
+}
+
+const ArrowDown = props => (
+  <Icon {...props}>
+    <path d="M12 5v14" />
+    <path d="m19 12-7 7-7-7" />
+  </Icon>
+)
+
+const ArrowRight = props => (
+  <Icon {...props}>
+    <path d="M5 12h14" />
+    <path d="m12 5 7 7-7 7" />
+  </Icon>
+)
+
+const CheckCircle2 = props => (
+  <Icon {...props}>
+    <path d="M21.801 10A10 10 0 1 1 17 3.335" />
+    <path d="m9 11 3 3L22 4" />
+  </Icon>
+)
+
+const Clock3 = props => (
+  <Icon {...props}>
+    <circle cx="12" cy="12" r="10" />
+    <path d="M12 6v6h6" />
+  </Icon>
+)
+
+const FileText = props => (
+  <Icon {...props}>
+    <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
+    <path d="M14 2v4a2 2 0 0 0 2 2h4" />
+    <path d="M10 9H8" />
+    <path d="M16 13H8" />
+    <path d="M16 17H8" />
+  </Icon>
+)
+
+const LayoutGrid = props => (
+  <Icon {...props}>
+    <rect x="3" y="3" width="7" height="7" rx="1" />
+    <rect x="14" y="3" width="7" height="7" rx="1" />
+    <rect x="14" y="14" width="7" height="7" rx="1" />
+    <rect x="3" y="14" width="7" height="7" rx="1" />
+  </Icon>
+)
+
+const ListChecks = props => (
+  <Icon {...props}>
+    <path d="m3 7 2 2 3-3" />
+    <path d="m3 17 2 2 3-3" />
+    <path d="M11 6h10" />
+    <path d="M11 12h10" />
+    <path d="M11 18h10" />
+  </Icon>
+)
+
+const ShieldCheck = props => (
+  <Icon {...props}>
+    <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
+    <path d="m9 12 2 2 4-4" />
+  </Icon>
+)
+
+const Sparkles = props => (
+  <Icon {...props}>
+    <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z" />
+  </Icon>
+)
+
+const TrendingUp = props => (
+  <Icon {...props}>
+    <path d="M16 7h6v6" />
+    <path d="m22 7-8.5 8.5-5-5L2 17" />
+  </Icon>
+)
+
+export default {
+  ArrowDown,
+  ArrowRight,
+  CheckCircle2,
+  Clock3,
+  FileText,
+  LayoutGrid,
+  ListChecks,
+  ShieldCheck,
+  Sparkles,
+  TrendingUp,
+}
