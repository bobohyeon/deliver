+        done_stmt = select(func.count()).select_from(Task).where(
+            Task.project_id == project_id,
+            Task.status == "DONE",
+        )
+        total = int(self._db.execute(total_stmt).scalar() or 0)
+        done = int(self._db.execute(done_stmt).scalar() or 0)
+        return total, done
