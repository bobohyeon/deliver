+    *,
+    unit_price: str,
+) -> AmountItem:
+    row = AmountItem(
+        id=item_id,
+        document_id=document_id,
+        analysis_id=analysis_id,
+        item_name="특급기술자",
+        quantity=Decimal("1"),
+        unit="인월",
+        unit_price=Decimal(unit_price),
+        amount=Decimal(unit_price),
+        currency="KRW",
+        reason="test",
+        decision=decision,
+        source_text_revision=1,
