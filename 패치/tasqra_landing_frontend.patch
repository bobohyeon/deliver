+.landing-page {
+  --landing-max: 1320px;
+  width: min(var(--landing-max), 100%);
+  min-height: 100svh;
+  margin: 0 auto;
+  overflow: hidden;
+  background: var(--c-bg);
+  color: var(--c-text);
+  font-family: Pretendard, "Noto Sans KR", "Malgun Gothic", "Apple SD Gothic Neo", var(--c-sans);
+  -webkit-font-smoothing: antialiased;
+}
+
+.landing-page *,
+.landing-page *::before,
+.landing-page *::after {
+  box-sizing: border-box;
+}
+
+.landing-page a { color: inherit; text-decoration: none; }
+.landing-page button { font: inherit; }
+.landing-page a:focus-visible,
+.landing-page button:focus-visible { outline: 3px solid var(--c-accent-border); outline-offset: 3px; }
+
+.landing-page__header {
+  position: relative;
+  z-index: 20;
+  display: flex;
+  min-height: 74px;
+  align-items: center;
+  justify-content: space-between;
+  padding: 0 clamp(24px, 4vw, 64px);
+  border-bottom: 1px solid var(--c-border);
+  background: rgba(255, 255, 255, 0.96);
+  backdrop-filter: blur(12px);
+}
+
+.landing-page__brand { display: inline-flex; align-items: center; }
+.landing-page__brand .logo { gap: 8px; color: var(--tasqra-rail, #0f2f74); font-size: 19px; }
+.landing-page__brand .logo-mark { width: 31px; height: 31px; }
+
+.landing-page__header-actions {
+  display: flex;
+  align-items: center;
+  gap: 20px;
+}
+
+.landing-page__login,
+.landing-page__button {
+  border: 0;
+  cursor: default;
+}
+
+.landing-page__login {
+  padding: 8px 0;
+  background: transparent;
+  color: var(--c-text);
+  font-size: 14px;
+  font-weight: 650;
+  transition: color 180ms ease;
+}
+
+.landing-page__login:hover { color: var(--c-accent); }
+
+.landing-page__button {
+  display: inline-flex;
+  min-height: 40px;
+  align-items: center;
+  justify-content: center;
+  gap: 7px;
+  padding: 0 17px;
+  border: 1px solid var(--c-accent);
+  border-radius: var(--c-radius-sm);
+  background: var(--c-accent);
+  color: #fff;
+  font-size: 14px;
+  font-weight: 750;
+  box-shadow: 0 7px 16px var(--c-accent-bg);
+  transition: transform 180ms ease, background 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
