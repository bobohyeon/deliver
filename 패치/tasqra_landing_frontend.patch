+// 책임: 랜딩 화면에서 사용하는 선형 SVG 아이콘을 한곳에서 제공한다.
+// 관계: MainHero.jsx와 LandingPage.jsx가 같은 아이콘 스타일을 공유한다.
+// Spring 비교: 공통 UI 컴포넌트를 주입해 중복 구현을 막는 작은 View 전용 Bean 모음과 같다.
+function Icon({ children, className = '' }) {
+  return (
+    <svg
+      className={className}
+      viewBox="0 0 24 24"
+      fill="none"
+      stroke="currentColor"
+      strokeWidth="2"
+      strokeLinecap="round"
+      strokeLinejoin="round"
+      aria-hidden="true"
+    >
+      {children}
+    </svg>
+  )
+}
+
+export const ArrowRight = props => (
+  <Icon {...props}>
+    <path d="M5 12h14" />
+    <path d="m13 6 6 6-6 6" />
+  </Icon>
+)
+
+export const FileText = props => (
+  <Icon {...props}>
+    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
+    <path d="M14 2v6h6" />
+    <path d="M9 13h6M9 17h4" />
+  </Icon>
+)
+
+export const Sparkles = props => (
+  <Icon {...props}>
+    <path d="M9.9 15.5A2 2 0 0 0 8.5 14.1l-6.1-1.6a.5.5 0 0 1 0-1L8.5 9.9A2 2 0 0 0 9.9 8.5l1.6-6.1a.5.5 0 0 1 1 0l1.6 6.1a2 2 0 0 0 1.4 1.4l6.1 1.6a.5.5 0 0 1 0 1l-6.1 1.6a2 2 0 0 0-1.4 1.4l-1.6 6.1a.5.5 0 0 1-1 0Z" />
+  </Icon>
+)
+
+export const Grid = props => (
+  <Icon {...props}>
+    <rect x="3" y="3" width="7" height="7" rx="1" />
+    <rect x="14" y="3" width="7" height="7" rx="1" />
+    <rect x="14" y="14" width="7" height="7" rx="1" />
+    <rect x="3" y="14" width="7" height="7" rx="1" />
+  </Icon>
+)
+
+export const Users = props => (
+  <Icon {...props}>
+    <circle cx="9" cy="8" r="3" />
+    <path d="M3 20c0-3 2.7-5 6-5s6 2 6 5" />
+    <circle cx="17" cy="9" r="2.4" />
+    <path d="M16 15c2.5 0 5 1.6 5 5" />
+  </Icon>
+)
+
+export const LinkIcon = props => (
+  <Icon {...props}>
+    <path d="M10 13a5 5 0 0 0 7.5.5l2-2a5 5 0 0 0-7-7l-1.1 1" />
+    <path d="M14 11a5 5 0 0 0-7.5-.5l-2 2a5 5 0 0 0 7 7l1.1-1" />
+  </Icon>
+)
+
+export const Review = props => (
+  <Icon {...props}>
+    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
+    <path d="M14 2v6h6" />
+    <path d="m9 15 2 2 4-5" />
+  </Icon>
+)
+
+export const Clock = props => (
+  <Icon {...props}>
+    <circle cx="12" cy="12" r="9" />
+    <path d="M12 7v5l3 2" />
+  </Icon>
+)
