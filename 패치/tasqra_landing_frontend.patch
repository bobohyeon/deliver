+// 책임: 공개 랜딩의 헤더와 핵심 메시지·문서 처리 흐름 이미지를 표시한다.
+// 관계: LandingPage의 첫 화면이며 공통 Logo, 팀 테마 변수, 로컬 hero-flow 이미지를 재사용한다.
+// Spring 비교: Controller가 반환하는 첫 View 조각처럼 데이터 호출 없이 정적 화면만 구성한다.
+import Logo from '../common/Logo'
+import heroFlow from '../../assets/landing/hero-flow.jpg'
+import { ArrowRight } from './heroIcons'
+
+export default function MainHero() {
+  return (
+    <>
+      <header className="landing-page__header">
+        <a className="landing-page__brand" href="#top" aria-label="Tasqra 홈">
+          <Logo />
+        </a>
+
+        <div className="landing-page__header-actions" aria-label="계정 메뉴 미리보기">
+          <button className="landing-page__login" type="button">로그인</button>
+          <button className="landing-page__button landing-page__button--small" type="button">
+            무료로 시작하기
+            <ArrowRight />
+          </button>
+        </div>
+      </header>
+
+      <section className="landing-page__hero" id="top">
+        <div className="landing-page__hero-copy">
+          <p className="landing-page__eyebrow">DOCUMENT INTELLIGENCE WORKSPACE</p>
+          <h1>
+            흩어진 문서를<br />
+            실행 가능한 <strong>프로젝트로</strong>
+          </h1>
+          <p className="landing-page__hero-description">
+            AI가 문서의 핵심을 분석하고,<br />
+            프로젝트와 태스크로 전환해 실행까지 지원합니다.
+          </p>
+
+          <div className="landing-page__hero-actions">
+            <button className="landing-page__button" type="button">
+              무료로 시작하기
+              <ArrowRight />
+            </button>
+            <a className="landing-page__button landing-page__button--outline" href="#how-it-works">
+              작동 방식 보기
+            </a>
+          </div>
+
+          <div className="landing-page__hero-notes" aria-label="주요 장점">
+            <span>원문 근거 연결</span>
+            <span>프로젝트별 권한</span>
+            <span>검토 이력 기록</span>
+          </div>
+        </div>
+
+        <div className="landing-page__hero-visual">
+          <div className="landing-page__hero-art">
+            <img
+              src={heroFlow}
+              alt="문서를 업로드하면 프로젝트 생성, 태스크 및 일정 생성, 핵심 요약 제공으로 이어지는 흐름"
